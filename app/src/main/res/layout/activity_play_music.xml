<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="24dp"
    tools:context=".PlayMusicActivity">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/albumArt"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="24dp"
        android:background="@color/halloween_surface_high"
        android:contentDescription="@string/album_art"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_album_placeholder"
        app:layout_constraintBottom_toTopOf="@id/songTitle"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0"
        app:layout_constraintWidth_max="360dp"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Large"
        app:strokeColor="@color/halloween_orange"
        app:strokeWidth="2dp" />

    <TextView
        android:id="@+id/songTitle"
        style="@style/recycle_item_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginVertical="24dp"
        android:gravity="center"
        android:text="@string/new_list_name_default"
        android:textAppearance="?attr/textAppearanceHeadlineSmall"
        android:textColor="?attr/colorPrimary"
        app:layout_constraintBottom_toTopOf="@id/positionBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <SeekBar
        android:id="@+id/positionBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingHorizontal="0dp"
        app:layout_constraintBottom_toTopOf="@id/elapsedTimeLabel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/elapsedTimeLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/time_zero"
        android:textColor="?attr/colorOnSurfaceVariant"
        app:layout_constraintBottom_toTopOf="@id/playBtn"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/remainingTimeLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/time_zero"
        android:textColor="?attr/colorOnSurfaceVariant"
        app:layout_constraintBottom_toTopOf="@id/playBtn"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/playBtn"
        style="@style/Widget.Material3.Button.Icon"
        android:layout_width="88dp"
        android:layout_height="88dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="32dp"
        android:contentDescription="@string/play_pause"
        android:insetLeft="0dp"
        android:insetTop="0dp"
        android:insetRight="0dp"
        android:insetBottom="0dp"
        android:padding="0dp"
        app:icon="@drawable/ic_pause"
        app:iconGravity="textStart"
        app:iconPadding="0dp"
        app:iconSize="48dp"
        app:cornerRadius="44dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/restartBtn"
        style="@style/PlayerIconButton"
        android:contentDescription="@string/restart"
        app:icon="@drawable/ic_restart"
        app:iconSize="32dp"
        app:layout_constraintBottom_toBottomOf="@id/playBtn"
        app:layout_constraintEnd_toStartOf="@id/playBtn"
        app:layout_constraintTop_toTopOf="@id/playBtn" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/SkipBtn"
        style="@style/PlayerIconButton"
        android:contentDescription="@string/skip"
        app:icon="@drawable/ic_skip_next"
        app:iconSize="32dp"
        app:layout_constraintBottom_toBottomOf="@id/playBtn"
        app:layout_constraintStart_toEndOf="@id/playBtn"
        app:layout_constraintTop_toTopOf="@id/playBtn" />

</androidx.constraintlayout.widget.ConstraintLayout>
